{
  "name": "exp-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client-side EXP / Meso tracker - browser port of ExpMesoTracker. OCR, math and storage all run in the user's browser; the site is static.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "onnxruntime-web": "^1.19.2",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "jimp": "^0.22.12",
    "typescript": "5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
